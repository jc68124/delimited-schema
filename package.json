{
  "name": "@jc68124/delimited-schema",
  "version": "0.1.0",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "description": "Define reusable schemas to create, parse and validate delimited text files.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
      ".": {
          "import": {
              "types": "./dist/index.d.ts",
              "default": "./dist/index.js"
          },
          "require": {
              "types": "./dist/index.d.cts",
              "default": "./dist/index.cjs"
          }
      }
  },
  "files": ["dist"],
  "publishConfig": {
      "access": "public"
  },
  "scripts": {
      "build": "tsup",
      "typecheck": "tsc --noEmit",
      "test": "vitest run",
      "test:watch": "vitest",
      "changeset": "changeset",
      "release": "pnpm build && changeset publish"
  },
  "repository": {
      "type": "git",
      "url": "git+https://github.com/jc68124/delimited-schema.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
